        {
          "Position": { "X": 9, "Y": 5 },
          "Layer": "Buildings",
          "SetProperties": { "Passable": "T" }
        },
        {
          "Position": { "X": 10, "Y": 5 },
          "Layer": "Buildings",
          "SetProperties": { "Passable": "T" }
        },
        {
          "Position": { "X": 11, "Y": 5 },
          "Layer": "Buildings",
          "SetProperties": { "Passable": "T" }
        }
      ]
    },
    {
