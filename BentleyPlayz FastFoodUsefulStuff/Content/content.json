    {
      "LogName": "Welcome letter from Bentley",
      "Action": "EditData",
      "Target": "Data/Mail",
      "Entries": {
        "{{ModId}}_WelcomeLetter": "Dear @,^Welcome to Pelican Town! My name is Bentley, and I am the owner of Bentley's Fast Food, located in the Bus Stop, just east of the bus.^We are open 24 hours a day, every day, and we serve hot, freshly prepared meals made for hardworking farmers.^Please stop by our shop when you have a moment. We would be delighted to welcome you.^^Sincerely,^   -Bentley^Owner, Bentley's Fast Food[#]Welcome to Pelican Town"
      }
    },
    {
      "LogName": "Send the welcome letter once, on the first day loaded",
      "When": { "NewPlayerWelcome": "true" },
      "Action": "EditData",
      "Target": "Data/TriggerActions",
      "Entries": {
        "{{ModId}}_SendWelcomeLetter": {
          "Id": "{{ModId}}_SendWelcomeLetter",
          "Trigger": "DayStarted",
          "Condition": "!PLAYER_HAS_MAIL Current {{ModId}}_WelcomeLetter Any",
          "Actions": [
            "AddMail Current {{ModId}}_WelcomeLetter Now"
          ]
        }
      }
    }
  ],
  "ConfigSchema": {
    "NewPlayerWelcome": {
      "AllowValues": "true, false",
      "Default": "true",
      "Description": "Everything that treats you as brand new: Bentley's welcome letter and his first-time introduction dialogue. Turn off to skip all of it."
    },
    "EnableFestivals": {
      "AllowValues": "true, false",
      "Default": "false",
      "Description": "EXPERIMENTAL: add Bentley to vanilla festivals. Unverified in-game; off by default."
    }
